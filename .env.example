# Copy to .env.local and adjust. Only variables prefixed with VITE_ reach the browser,
# so never put secrets here.
VITE_APP_NAME=SuperNova PSMS
VITE_APP_VERSION=1.0
# Base URL of the serialization backend / SAP gateway.
VITE_API_BASE_URL=http://localhost:8080/api
# true = run entirely on the in-browser mock register (demo build).
VITE_USE_MOCK=true
